// A small 2D scene graph derived from ddgfx.pas.
//
// The Lazarus TOpenGLControl wrapper is intentionally replaced by
// ODdScene: the caller owns the GLFW window and drives BeginFrame and
// EndFrame from its normal event loop.

use math
use ./openglutils

struct SDdMatrix:
    // A 2D affine matrix: xx, xy, yx, yy, tx, ty.
    values : [6]float32

    func SetIdentity():
        values[0] = 1
        values[1] = 0
        values[2] = 0
        values[3] = 1
        values[4] = 0
        values[5] = 0
    endfunc
endstruct

struct SDdVertex:
    x : float32
    y : float32
endstruct

struct SDdColor:
    red   : float32
    green : float32
    blue  : float32
    alpha : float32

    func Set(ared : float32, agreen : float32, ablue : float32, aalpha : float32 = 1.0):
        red   = ared
        green = agreen
        blue  = ablue
        alpha = aalpha
    endfunc
endstruct

func DdColor(red : float32, green : float32, blue : float32, alpha : float32 = 1.0) -> SDdColor:
    result.red = red
    result.green = green
    result.blue = blue
    result.alpha = alpha
endfunc

func DdMatIdentity() -> SDdMatrix:
    result.values[0] = 1
    result.values[1] = 0
    result.values[2] = 0
    result.values[3] = 1
    result.values[4] = 0
    result.values[5] = 0
endfunc

func DdMatMultiply(first : SDdMatrix, second : SDdMatrix) -> SDdMatrix:
    result.values[0] = first.values[0] * second.values[0] + first.values[1] * second.values[2]
    result.values[1] = first.values[0] * second.values[1] + first.values[1] * second.values[3]
    result.values[2] = first.values[2] * second.values[0] + first.values[3] * second.values[2]
    result.values[3] = first.values[2] * second.values[1] + first.values[3] * second.values[3]
    result.values[4] = first.values[4] * second.values[0] + first.values[5] * second.values[2] + second.values[4]
    result.values[5] = first.values[4] * second.values[1] + first.values[5] * second.values[3] + second.values[5]
endfunc

func DdMatTransformPoint(matrix : SDdMatrix, point : SDdVertex) -> SDdVertex:
    result.x = point.x * matrix.values[0] + point.y * matrix.values[2] + matrix.values[4]
    result.y = point.x * matrix.values[1] + point.y * matrix.values[3] + matrix.values[5]
endfunc

func DdMatProjection(width : int, height : int) -> SDdMatrix:
    result = DdMatIdentity()
    result.values[0] =  2.0 / width
    result.values[3] = -2.0 / height
    result.values[4] = -1.0 + 0.5 / width
    result.values[5] =  1.0 - 0.5 / height
endfunc

object ODrawable:
    parent  : ODrawable = nil
    x       : float32 = 0.0
    y       : float32 = 0.0
    scaleX  : float32 = 1.0
    scaleY  : float32 = 1.0
    rotation : float32 = 0.0 // degrees
    alpha   : float32 = 1.0
    visible : bool = true

    func *Create(parent : ODrawable)
    func *Destroy()
    func Matrix() -> SDdMatrix
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[virtual]]
endobject

object OPrimitive:
    mode     : uint32 = GL_TRIANGLES
    vertices : [*]SDdVertex

    func *Create(mode : uint32, vertices : []SDdVertex)
    func Draw(matrix : SDdMatrix)
endobject

object OShape(ODrawable):
    color     : SDdColor = DdColor(1.0, 1.0, 1.0)
    lineWidth : float32 = 1.0
    primitives : [*]OPrimitive

    func *Create(parent : ODrawable)
    func *Destroy()
    func AddPrimitive(mode : uint32, vertices : []SDdVertex) -> OPrimitive
    func Clear()
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object OClonedShape(ODrawable):
    original : OShape = nil
    color    : SDdColor = DdColor(1.0, 1.0, 1.0)

    func *Create(parent : ODrawable, original : OShape)
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object OClonedGroup(ODrawable):
    // Keeping this as the base type breaks the otherwise circular DQ type
    // declaration between a group and a clone of a group.
    original : ODrawable = nil

    func *Create(parent : ODrawable, original : ODrawable)
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object ODrawGroup(ODrawable):
    children : [*]ODrawable

    func *Create(parent : ODrawable)
    func *Destroy()
    func AddChild(child : ODrawable)
    func RemoveChild(child : ODrawable)
    func NewGroup() -> ODrawGroup
    func NewShape() -> OShape
    func CloneShape(original : OShape) -> OClonedShape
    func CloneGroup(original : ODrawGroup) -> OClonedGroup
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object ODdScene:
    window     : pointer = nil
    root       : ODrawGroup = nil
    background : SDdColor = DdColor(0.0, 0.0, 0.0)
    projection : SDdMatrix

    func *Create(window : pointer)
    func *Destroy()
    func BeginFrame(width : int, height : int)
    func EndFrame()
endobject

func ODrawable.*Create(parent : ODrawable):
    self.parent = parent
    if parent is ODrawGroup:
        var group : ODrawGroup tryfrom parent
        group.AddChild(self)
    endif
endfunc

func ODrawable.*Destroy():
    if parent is ODrawGroup:
        var group : ODrawGroup tryfrom parent
        group.RemoveChild(self)
    endif
endfunc

func ODrawable.Matrix() -> SDdMatrix:
    var radians : float64 = rotation * 3.141592653589793 / 180.0
    var cosine : float32  = @math.Cos(radians)
    var sine : float32    = @math.Sin(radians)

    result.values[0] = scaleX * cosine
    result.values[1] = -scaleY * sine
    result.values[2] = scaleX * sine
    result.values[3] = scaleY * cosine
    result.values[4] = x
    result.values[5] = y
endfunc

func ODrawable.Draw(parent_matrix : SDdMatrix, parent_alpha : float32):
endfunc

func OPrimitive.*Create(mode : uint32, vertices : []SDdVertex):
    self.mode = mode
    var index : int = 0
    while index < vertices.length:
        self.vertices.Append(vertices[index])
        index += 1
    endwhile
endfunc

func OPrimitive.Draw(matrix : SDdMatrix):
    use *
    GlBegin(mode)
    var index : int = 0
    while index < vertices.length:
        var point : SDdVertex = DdMatTransformPoint(matrix, vertices[index])
        GlVertex2f(point.x, point.y)
        index += 1
    endwhile
    GlEnd()
endfunc

func OShape.*Create(parent : ODrawable):
    inherited Create(parent)
endfunc

func OShape.*Destroy():
    Clear()
    inherited Destroy()
endfunc

func OShape.AddPrimitive(mode : uint32, vertices : []SDdVertex) -> OPrimitive:
    result = new OPrimitive(mode, vertices)
    primitives.Append(result)
endfunc

func OShape.Clear():
    while primitives.length > 0:
        delete primitives.PopFirst()
    endwhile
endfunc

func OShape.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    use *
    var matrix : SDdMatrix = DdMatMultiply(Matrix(), parent_matrix)
    GlColor4f(color.red, color.green, color.blue, color.alpha * parent_alpha * alpha)
    GlLineWidth(lineWidth)

    for index : int = 0 count primitives.length:
        primitives[index].Draw(matrix)
    endfor
endfunc

func OClonedShape.*Create(parent : ODrawable, original : OShape):
    inherited Create(parent)
    self.original = original
    if original <> nil:
        color = original.color
        x = original.x
        y = original.y
        scaleX = original.scaleX
        scaleY = original.scaleY
        rotation = original.rotation
        alpha = original.alpha
        visible = original.visible
    endif
endfunc

func OClonedShape.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    if original == nil:
        return
    endif

    use *

    var matrix : SDdMatrix = DdMatMultiply(Matrix(), parent_matrix)
    GlColor4f(color.red, color.green, color.blue, color.alpha * parent_alpha * alpha)
    GlLineWidth(original.lineWidth)

    for index : int = 0 count original.primitives.length:
        original.primitives[index].Draw(matrix)
    endfor
endfunc

func ODrawGroup.*Create(parent : ODrawable):
    inherited Create(parent)
endfunc

func ODrawGroup.*Destroy():
    while children.length > 0:
        delete children.PopFirst()
    endwhile
    inherited Destroy()
endfunc

func ODrawGroup.AddChild(child : ODrawable):
    children.Append(child)
    child.parent = self
endfunc

func ODrawGroup.RemoveChild(child : ODrawable):
    for index : int = 0 count children.length:
        if children[index] == child:
            children.Delete(index)
            child.parent = nil
            return
        endif
    endfor
endfunc

func ODrawGroup.NewGroup() -> ODrawGroup:
    return new ODrawGroup(self)
endfunc

func ODrawGroup.NewShape() -> OShape:
    return new OShape(self)
endfunc

func ODrawGroup.CloneShape(original : OShape) -> OClonedShape:
    return new OClonedShape(self, original)
endfunc

func ODrawGroup.CloneGroup(original : ODrawGroup) -> OClonedGroup:
    return new OClonedGroup(self, original)
endfunc

func ODrawGroup.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    var matrix : SDdMatrix = @.DdMatMultiply(Matrix(), parent_matrix)
    var child_alpha : float32 = parent_alpha * alpha
    for index : int = 0 count children.length:
        if children[index].visible:
            children[index].Draw(matrix, child_alpha)
        endif
    endfor
endfunc

func OClonedGroup.*Create(parent : ODrawable, original : ODrawable):
    inherited Create(parent)
    self.original = original
    if original <> nil:
        x = original.x
        y = original.y
        scaleX = original.scaleX
        scaleY = original.scaleY
        rotation = original.rotation
        alpha = original.alpha
        visible = original.visible
    endif
endfunc

func OClonedGroup.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    if not (original is ODrawGroup):
        return
    endif

    var group : ODrawGroup tryfrom original

    var matrix : SDdMatrix = @.DdMatMultiply(Matrix(), parent_matrix)
    var child_alpha : float32 = parent_alpha * alpha
    for index : int = 0 count group.children.length:
        if group.children[index].visible:
            group.children[index].Draw(matrix, child_alpha)
        endif
    endfor
endfunc

func ODdScene.*Create(window : pointer):
    use *
    self.window = window
    root = new ODrawGroup(nil)
    projection = DdMatIdentity()
    GlEnable(GL_BLEND)
    GlBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
endfunc

func ODdScene.*Destroy():
    delete root
endfunc

func ODdScene.BeginFrame(width : int, height : int):
    use *
    projection = DdMatProjection(width, height)
    GlClearColor(background.red, background.green, background.blue, background.alpha)
    GlClear(GL_COLOR_BUFFER_BIT)
    root.Draw(projection, 1.0)
endfunc

func ODdScene.EndFrame():
    use *
    GlfwSwapBuffers(window)
endfunc
