{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dq: build DdGfx test 1 debug",
      "type": "shell",
      "command": "build/dq-comp",
      "args": [
        "-g",
        "-O0",
        "--build",
        "vscode_ddgfx",
        "--pkg-path",
        "${workspaceFolder}/stdpkg",
        "examples/opengl/ddgfxtest1.dq",
        "-o",
        "examples/opengl/ddgfxtest1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "dq: build configured target",
      "type": "shell",
      "command": "build/dq-comp",
      "args": [
        "-g",
        "-O0",
        "${config:dq.debugTarget}.dq",
        "-o",
        "${config:dq.debugTarget}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dq: build active file",
      "type": "shell",
      "command": "build/dq-comp",
      "args": [
        "-g",
        "-O0",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dq: build bare test1",
      "type": "shell",
      "command": "./test1_comp.sh",
      "options": {
        "cwd": "${workspaceFolder}/examples/bare/test1"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
